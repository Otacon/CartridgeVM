uniform shader spriteTexture;
uniform float2 destinationOrigin;
uniform float2 destinationSize;

const float2 sourceSize = float2(256.0, 240.0);
const float2 shadowOffsetPixels = float2(4.0, 4.0);

float spriteAlpha(float2 sourcePoint) {
    if (sourcePoint.x < 0.0 || sourcePoint.y < 0.0 || sourcePoint.x >= sourceSize.x || sourcePoint.y >= sourceSize.y) {
        return 0.0;
    }
    return spriteTexture.eval(sourcePoint).a;
}

float sampleShadow(float2 center, float2 sourcePerDevicePixel, float2 pixelOffset, float weight) {
    return spriteAlpha(center + pixelOffset * sourcePerDevicePixel) * weight;
}

float4 main(float2 devicePoint) {
    float2 textureCoordinate = (devicePoint - destinationOrigin) / destinationSize;
    float2 sourcePoint = textureCoordinate * sourceSize;
    float2 sourcePerDevicePixel = sourceSize / destinationSize;

    float2 center = sourcePoint + shadowOffsetPixels * sourcePerDevicePixel;
    float blur = sampleShadow(center, sourcePerDevicePixel, float2(0.0, 0.0), 0.80);
    float alpha = blur * 0.64;

    return float4(0.0, 0.0, 0.0, alpha);
}
